# ==== Bảo mật phiên (BẮT BUỘC ở production) ====
# Chuỗi ngẫu nhiên đủ dài để ký cookie phiên (HMAC). Sinh bằng: openssl rand -hex 32
SESSION_SECRET=

# ==== Supabase (lưu trữ thật) ====
# Lấy từ Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://bgwffnasksdpiiuakjhw.supabase.co
# service_role secret — CHỈ dùng server-side, TUYỆT ĐỐI không để lộ ra client
SUPABASE_SERVICE_ROLE_KEY=
# Anon/publishable key (an toàn để công khai) — dùng cho client nếu cần realtime
NEXT_PUBLIC_SUPABASE_URL=https://bgwffnasksdpiiuakjhw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ==== Tùy chọn ====
# Token bí mật cho webhook nhận lead (/api/leads/ingest)
LEAD_INGEST_TOKEN=
